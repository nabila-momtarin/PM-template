# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
SERVER_PORT=5132
CORS_ORIGIN=*
NODE_ENV=development
SERVICE_NAME=my-service
SERVICE_ID=

# ─────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────
RBAC_ENABLED=false
SWAGGER_ENABLED=false

# ─────────────────────────────────────────────
# DATABASE (MongoDB)
# ─────────────────────────────────────────────
DATABASE_URL=mongodb://localhost:27017/your-db-name

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_LOGS=false

# ─────────────────────────────────────────────
# KAFKA
# ─────────────────────────────────────────────
KAFKA_CLIENT_ID=
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=

# ─────────────────────────────────────────────
# INTERNAL API KEY (server-to-server communication)
# ─────────────────────────────────────────────
INTERNAL_API_KEY=change-me-to-a-strong-secret

# ─────────────────────────────────────────────
# RATE LIMITING (uncomment in main.ts to activate)
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────
# EXTERNAL SERVICES
# ─────────────────────────────────────────────
NOTIFICATION_SERVICE_URL=
BILLING_SERVICE_URL=
BUSINESS_SERVICE_URL=
SUBSCRIPTION_SERVICE_URL=
VBS_SERVICE_URL=
META_SERVICE_URL=
RBAC_SERVICE_URL=
